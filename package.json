{
  "name": "dark-factory",
  "version": "0.1.0",
  "private": true,
  "description": "AI software factory: Ralph, Acceptance Verifier, Claude Code skills, agents and hooks",
  "files": [
    "skills/",
    "agents/",
    "hooks/",
    "profile/",
    "verifier/",
    "judge/",
    "ralph/"
  ],
  "scripts": {
    "postinstall": "node .claude/scripts/setup-metaskills.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*.test.js\" \"skills/**/*.test.js\" \"agents/**/*.test.js\" \"hooks/**/*.test.js\" \"profile/**/*.test.js\" \"verifier/**/*.test.js\" \"judge/**/*.test.js\" \"ralph/**/*.test.js\" \"examples/**/*.test.js\" \".claude/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "metaskills": "^1.0.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
