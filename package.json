{
  "name": "dark-factory",
  "version": "0.1.3",
  "private": true,
  "description": "AI software factory: Ralph, Acceptance Verifier, Claude Code skills, agents and hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strakhovdenya/dark-factory.git"
  },
  "bin": {
    "dark-factory-pin": "bin/pin.js",
    "dark-factory-ralph-wsl": "bin/ralph-wsl.js",
    "dark-factory-setup": "bin/setup.js",
    "factory": "bin/doctor.js"
  },
  "files": [
    "bin/",
    "doctor/",
    "skills/",
    "agents/",
    "hooks/",
    "profile/",
    "verifier/",
    "judge/",
    "ralph/"
  ],
  "scripts": {
    "postinstall": "node bin/setup.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*.test.js\" \"bin/**/*.test.js\" \"doctor/**/*.test.js\" \"skills/**/*.test.js\" \"agents/**/*.test.js\" \"hooks/**/*.test.js\" \"profile/**/*.test.js\" \"verifier/**/*.test.js\" \"judge/**/*.test.js\" \"ralph/**/*.test.js\" \"examples/**/*.test.js\" \".claude/**/*.test.js\" \"test/installed-ralph.test.js\" \"test/fixture-cache.test.js\"",
    "prepare:ralph:sandbox": "node test/integration/prepare-ralph-sandbox.js",
    "test:ralph:sandbox": "node test/integration/run-ralph-sandbox.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dark-factory": "github:strakhovdenya/dark-factory#v0.1.2",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "metaskills": "1.0.5",
    "minimatch": "^10.2.6"
  }
}
