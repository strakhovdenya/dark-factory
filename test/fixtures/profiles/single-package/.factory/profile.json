{
  "branchTemplate": "task/ISSUE-{issue}-{slug}",
  "apps": [
    {
      "name": "main",
      "path": ".",
      "install": [{ "argv": ["npm", "install"], "cwd": "." }],
      "gate": [
        { "argv": ["node", "node_modules/eslint/bin/eslint.js", "."], "cwd": "." },
        { "argv": ["node", "node_modules/vitest/vitest.mjs", "run"], "cwd": "." }
      ]
    }
  ],
  "docOnlyPathPatterns": ["*.md", "docs/"],
  "protectedPaths": [".github/", "scripts/"],
  "ruleFiles": ["CLAUDE.md"],
  "verifier": {
    "goldenDir": "../../verifier/golden/single-package",
    "checks": ["test-tampering-scan", "ci-checks", "allowed-model"]
  },
  "sandbox": {
    "image": "factory-sandbox-test:single",
    "nodeVersion": "22.1",
    "claudeCodeVersion": "1.2.4",
    "allowedHosts": ["packages.example.org", "models.example.org"],
    "installEnv": { "SKIP_BINARY_DOWNLOAD": "true" }
  },
  "ralph": { "enabled": false }
}
