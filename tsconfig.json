{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "strict": false,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["*.js", ".claude/**/*.js", "bin/**/*.js", "skills/**/*.js", "agents/**/*.js", "hooks/**/*.js", "profile/**/*.js", "verifier/**/*.js", "judge/**/*.js", "ralph/**/*.js", "test/integration/**/*.js", "test/fixtures/ralph-sandbox/**/*.js"],
  "exclude": ["node_modules"]
}
